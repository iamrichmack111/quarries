#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

TODAY="$(date '+%Y-%m-%d')"
DAYROOT="$HOME/Desktop/Quarries-Daily-$TODAY"
ZIPROOT="$DAYROOT/zips"

mkdir -p "$DAYROOT" "$ZIPROOT"

# Import today's existing Quarries ZIPs from the Desktop.
for EXISTING in "$HOME/Desktop"/quarries-"$TODAY"-*-HEBREW.zip; do
    [[ -e "$EXISTING" ]] || continue
    cp -f "$EXISTING" "$ZIPROOT/"
done

echo
echo "QUARRIES → BLACK SQUARE"
echo "======================="
echo "Workspace: $DAYROOT"
echo

found=0

for ZIP in "$ZIPROOT"/quarries-"$TODAY"-*-HEBREW.zip; do
    [[ -e "$ZIP" ]] || continue
    found=1

    NAME="$(basename "$ZIP" .zip)"

    case "$NAME" in
        *Daf-Yomi*)
            STUDY="Daf-Yomi"
            ;;
        *Tanakh-Yomi*)
            STUDY="Tanakh-Yomi"
            ;;
        *Rambam-3-Chapters*)
            STUDY="Rambam"
            ;;
        *Rambam*)
            STUDY="Rambam"
            ;;
        *Mishnah*)
            STUDY="Mishnah"
            ;;
        *)
            STUDY="$NAME"
            ;;
    esac

    WORK="$DAYROOT/$STUDY"
    SOURCE="$WORK/source"
    OUTPUT="$WORK/output"

    rm -rf "$SOURCE"
    mkdir -p "$SOURCE" "$OUTPUT"

    echo
    echo "======================================"
    echo "$STUDY"
    echo "======================================"
    echo "Extracting:"
    echo "  $ZIP"

    ditto -x -k "$ZIP" "$SOURCE"

    ANALYSIS_MD=""

    if [[ -f "$SOURCE/analysis.md" ]]; then
        ANALYSIS_MD="$SOURCE/analysis.md"
    else
        ANALYSIS_MD="$(
            find "$SOURCE" -type f -name 'analysis.md' -print -quit || true
        )"
    fi

    if [[ -z "$ANALYSIS_MD" ]]; then
        ANALYSIS_MD="$(
            find "$SOURCE" -type f -name '*.md' \
                ! -iname 'README.md' \
                -print -quit || true
        )"
    fi

    if [[ -z "$ANALYSIS_MD" || ! -f "$ANALYSIS_MD" ]]; then
        echo "ERROR: no analysis Markdown found."
        continue
    fi

    echo "Analyzing:"
    echo "  $ANALYSIS_MD"

    python3 "$SCRIPT_DIR/bstm.py" prompt \
        --source "$ANALYSIS_MD" \
        --output "$OUTPUT" \
        > "$WORK/BLACK_SQUARE_PROMPT.md"

    cd "$WORK"

    echo
    echo "Running Codex..."
    echo

    if codex exec --help >/dev/null 2>&1; then
        codex exec \
            --skip-git-repo-check \
            --sandbox workspace-write \
            "$(cat BLACK_SQUARE_PROMPT.md)"
    else
        echo "Opening Codex interactively."
        echo "Prompt: $WORK/BLACK_SQUARE_PROMPT.md"
        codex "$(cat BLACK_SQUARE_PROMPT.md)"
    fi

    echo
    if ! python3 "$SCRIPT_DIR/bstm.py" validate "$OUTPUT"; then
        echo "WARNING: BSTM validation failed for $STUDY" >&2
        echo "Continuing to the next daily study." >&2
    fi

    echo "Outputs:"
    echo "  $OUTPUT/BSTM_ADVERSARIAL_MANUAL.md"
    echo "  $OUTPUT/BSTM_DEFENSE_MANUAL.md"
    echo "  $OUTPUT/BSTM_SHARED_SOURCE_APPENDICES.md"

    cd "$SCRIPT_DIR"
done

if [[ "$found" -eq 0 ]]; then
    echo
    echo "No Quarries ZIPs found in:"
    echo "  $ZIPROOT"
    exit 1
fi

echo
echo "======================="
echo "COMPLETE"
echo "======================="
echo "$DAYROOT"
