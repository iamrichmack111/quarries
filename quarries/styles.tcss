Screen {
    background: #06080c;
    color: #d8e0e8;
}

Header, Footer {
    background: #0a0e14;
    color: #cbd5e1;
}

LoginScreen, SetupScreen, PasswordModal, ConfirmModal, TabPane {
    align-horizontal: center;
}

#gate-box {
    width: 82;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    background: #0b1017;
    border: round #2b394d;
}

#gate-heading {
    height: 11;
}

#gate-brand, #main-brand {
    text-style: bold;
    color: #edf4fa;
}

#gate-brand {
    padding-top: 2;
}

#corner-eyes {
    width: 42;
    height: 10;
    text-align: right;
    content-align: right top;
}

#top-strip {
    height: 8;
    padding: 0 1;
    background: #080c12;
    border-bottom: solid #1f2937;
}

#main-brand {
    width: 1fr;
    padding-top: 2;
}

#global-status {
    width: 34;
    padding-top: 2;
    color: #94a3b8;
}

#corner-eyes-main {
    width: 48;
    height: 7;
    text-align: right;
    content-align: right top;
}

TabbedContent {
    height: 1fr;
}

.muted {
    color: #8792a1;
}

.muted-small {
    color: #6f7b89;
    height: 2;
}

.error {
    color: #f87171;
}

Input, TextArea, Select {
    background: #080c12;
    color: #eef2f7;
    border: round #334155;
}

Input:focus, TextArea:focus, Select:focus {
    border: round #60a5fa;
}

Button {
    background: #1d2735;
    color: #e5edf5;
    border: tall #3b4a5f;
    margin-right: 1;
}

Button:focus {
    background: #33445d;
    border: tall #93c5fd;
}

#setup-grid {
    grid-size: 2;
    grid-columns: 28 1fr;
    grid-gutter: 1;
    height: auto;
}

#modal-box, #confirm-box {
    width: 62;
    height: auto;
    margin: 8 4;
    padding: 2;
    background: #0b1017;
    border: round #64748b;
}

.modal-title, .pane-title {
    text-style: bold;
    color: #b9c7d8;
}

.button-row {
    height: 4;
    align-horizontal: center;
}

#archive-root, #watcher-root {
    height: 1fr;
}

#archive-toolbar, #watcher-toolbar {
    height: 5;
    padding: 0 1;
    background: #090d13;
    border-bottom: solid #1f2937;
}

#archive-status, #watcher-status {
    width: 1fr;
    padding: 1 0 0 1;
    color: #94a3b8;
}

#archive-grid {
    grid-size: 3;
    grid-columns: 26 1fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1;
    height: 1fr;
    padding: 1;
}

.pane {
    height: 1fr;
    background: #080c12;
    border: round #263448;
    padding: 1;
}

#leaf-search, #leaf-title {
    height: 3;
    margin-bottom: 1;
}

#leaf-list, #english-editor {
    height: 1fr;
}

#normal-hebrew-preview {
    height: 1fr;
    min-height: 7;
    padding: 1;
    text-align: right;
    content-align: right top;
    color: #f1f5f9;
    background: #05080d;
    border: round #334155;
    margin-bottom: 1;
}

.secondary-title {
    margin-top: 1;
}

#encoded-preview {
    height: 1fr;
    min-height: 7;
    padding: 1;
    text-align: right;
    content-align: right top;
    color: #bae6fd;
    background: #05080d;
    border: round #334155;
}

/* Watcher: conversation occupies nearly all available height. */
#watcher-layout {
    height: 1fr;
    padding: 1;
}

#sessions-pane {
    width: 28;
    min-width: 22;
    height: 1fr;
    margin-right: 1;
    padding: 1;
    background: #080c12;
    border: round #263448;
}

#session-list {
    height: 1fr;
}

#conversation-pane {
    width: 1fr;
    height: 1fr;
}

#chat-history {
    height: 1fr;
    padding: 1 2;
    background: #080c12;
    border: round #29384c;
    margin-bottom: 1;
}

.chat-message {
    margin-bottom: 1;
    padding: 1 2;
    background: #0d1520;
    border-left: thick #526b8e;
}

#chat-compose {
    height: 6;
}

#chat-input {
    width: 1fr;
    height: 5;
}

#chat-send {
    width: 14;
    height: 4;
}

#vault-box {
    width: 72;
    height: auto;
    margin: 2 4;
    padding: 2;
    background: #0b1017;
    border: round #334155;
}
