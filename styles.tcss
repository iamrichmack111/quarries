Screen {
    background: #06080c;
    color: #d8e0e8;
}

Header, Footer {
    background: #0a0e14;
    color: #cbd5e1;
}

LoginScreen, SetupScreen, PasswordModal, ConfirmModal, TabPane {
    align-horizontal: center;
}

#gate-box {
    width: 82;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    background: #0b1017;
    border: round #2b394d;
}

#gate-heading {
    height: 11;
}

#gate-brand, #main-brand {
    text-style: bold;
    color: #edf4fa;
}

#gate-brand {
    padding-top: 2;
}

#corner-eyes {
    width: 42;
    height: 10;
    text-align: right;
    content-align: right top;
}

#top-strip {
    height: 8;
    padding: 0 1;
    background: #080c12;
    border-bottom: solid #1f2937;
}

#main-brand {
    width: 1fr;
    padding-top: 2;
}

#global-status {
    width: 34;
    padding-top: 2;
    color: #94a3b8;
}

#corner-eyes-main {
    width: 48;
    height: 7;
    text-align: right;
    content-align: right top;
}

TabbedContent {
    height: 1fr;
}

.muted {
    color: #8792a1;
}

.muted-small {
    color: #6f7b89;
    height: 2;
}

.error {
    color: #f87171;
}

Input, TextArea, Select {
    background: #080c12;
    color: #eef2f7;
    border: round #334155;
}

Input:focus, TextArea:focus, Select:focus {
    border: round #60a5fa;
}

Button {
    background: #1d2735;
    color: #e5edf5;
    border: tall #3b4a5f;
    margin-right: 1;
}

Button:focus {
    background: #33445d;
    border: tall #93c5fd;
}

#setup-grid {
    grid-size: 2;
    grid-columns: 28 1fr;
    grid-gutter: 1;
    height: auto;
}

#modal-box, #confirm-box {
    width: 62;
    height: auto;
    margin: 8 4;
    padding: 2;
    background: #0b1017;
    border: round #64748b;
}

.modal-title, .pane-title {
    text-style: bold;
    color: #b9c7d8;
}

.button-row {
    height: 4;
    align-horizontal: center;
}

#archive-root, #watcher-root {
    height: 1fr;
}

#archive-toolbar, #watcher-toolbar {
    height: 5;
    padding: 0 1;
    background: #090d13;
    border-bottom: solid #1f2937;
}

#archive-status, #watcher-status {
    width: 1fr;
    padding: 1 0 0 1;
    color: #94a3b8;
}

#archive-grid {
    grid-size: 3;
    grid-columns: 26 1fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1;
    height: 1fr;
    padding: 1;
}

.pane {
    height: 1fr;
    background: #080c12;
    border: round #263448;
    padding: 1;
}

#leaf-search, #leaf-title {
    height: 3;
    margin-bottom: 1;
}

#leaf-list, #english-editor {
    height: 1fr;
}

#normal-hebrew-preview {
    height: 1fr;
    min-height: 7;
    padding: 1;
    text-align: right;
    content-align: right top;
    color: #f1f5f9;
    background: #05080d;
    border: round #334155;
    margin-bottom: 1;
}

.secondary-title {
    margin-top: 1;
}

#encoded-preview {
    height: 1fr;
    min-height: 7;
    padding: 1;
    text-align: right;
    content-align: right top;
    color: #bae6fd;
    background: #05080d;
    border: round #334155;
}



#watcher-reference-context {
    height: auto;
    max-height: 4;
    padding: 0 1;
    margin: 0 1;
    background: #0a1018;
    border: round #263448;
}

#watcher-reference-actions {
    height: 3;
    padding: 0 1;
}

/* Watcher: conversation occupies nearly all available height. */
#watcher-layout {
    height: 1fr;
    padding: 1;
}

#sessions-pane {
    width: 20;
    min-width: 16;
    height: 1fr;
    margin-right: 1;
    padding: 1;
    background: #080c12;
    border: round #263448;
}

#session-list {
    height: 1fr;
}

#conversation-pane {
    width: 1fr;
    height: 1fr;
}

#chat-history {
    height: 1fr;
    min-height: 18;
    padding: 1 2;
    background: #080c12;
    border: round #29384c;
    margin-bottom: 1;
}

.chat-message {
    margin-bottom: 1;
    padding: 1 2;
    background: #0d1520;
    border-left: thick #526b8e;
}

#chat-compose {
    height: 4;
}

#chat-input {
    width: 1fr;
    height: 3;
}

#chat-send {
    width: 12;
    height: 3;
}

#vault-box {
    width: 72;
    height: auto;
    margin: 2 4;
    padding: 2;
    background: #0b1017;
    border: round #334155;
}

/* Hebrew / Strong's local lexical workbench — MacBook layout */
#hebrew-root {
    height: 1fr;
}

#hebrew-intro {
    height: 3;
    padding: 0 1;
}

#hebrew-toolbar {
    height: 4;
    padding: 0 1;
    background: #090d13;
    border-bottom: solid #1f2937;
}

#hebrew-search {
    width: 1fr;
    margin-right: 1;
}

#hebrew-save-word {
    width: 12;
    margin-right: 1;
}

#hebrew-to-watcher {
    width: 20;
    margin-right: 1;
}

#hebrew-status {
    width: 26;
    padding-top: 1;
    color: #94a3b8;
}

#hebrew-layout {
    height: 1fr;
    min-height: 18;
    padding: 1;
}

#hebrew-results-pane {
    width: 28%;
    min-width: 28;
    margin-right: 1;
}

#hebrew-results {
    height: 1fr;
}

#hebrew-detail-pane {
    width: 47%;
    min-width: 42;
    height: 1fr;
    margin-right: 1;
}

#hebrew-detail {
    padding: 1;
}

#hebrew-saved-pane {
    width: 25%;
    min-width: 28;
    height: 1fr;
}

#hebrew-saved-list {
    height: 1fr;
    min-height: 6;
}

#hebrew-saved-actions {
    height: 4;
}

#hebrew-list-status {
    height: auto;
    max-height: 5;
    padding: 1;
    color: #94a3b8;
}

#gematria-toolbar {
    height: 5;
    min-height: 5;
    padding: 0 1;
    background: #090d13;
    border-top: solid #1f2937;
}

#gematria-title {
    width: 14;
    padding-top: 1;
    color: #bae6fd;
}

#gematria-input {
    width: 38%;
    min-width: 32;
    margin-right: 1;
}

#gematria-result {
    width: 1fr;
    padding: 1;
    color: #e2e8f0;
}


/* Gematria Dictionary */
#gemdict-root { height: 1fr; }
#gemdict-intro {
    height: 3;
    padding: 0 1;
    border-bottom: solid #1f2937;
}
#gemdict-toolbar {
    height: 4;
    padding: 0 1;
    background: #090d13;
}
#gemdict-calc-toolbar {
    height: 4;
    padding: 0 1;
    background: #090d13;
    border-bottom: solid #1f2937;
}
#gemdict-hebrew { width: 38%; min-width: 30; margin-right: 1; }
#gemdict-calc-all { width: 15; margin-right: 1; }
#gemdict-export-methods { width: 20; margin-right: 1; }
#gemdict-calc-status { width: 1fr; padding-top: 1; color: #94a3b8; }
#gemdict-value { width: 18; margin-right: 1; }
#gemdict-text { width: 1fr; margin-right: 1; }
#gemdict-methods { width: 12; margin-right: 1; }
#gemdict-status { width: 34; padding-top: 1; color: #94a3b8; }
#gemdict-layout { height: 1fr; padding: 1; }
#gemdict-results-pane {
    width: 27%;
    min-width: 28;
    height: 1fr;
    margin-right: 1;
}
#gemdict-results { height: 1fr; }
#gemdict-detail-pane {
    width: 48%;
    min-width: 44;
    height: 1fr;
    margin-right: 1;
}
#gemdict-detail { padding: 1; }
#gemdict-related-pane {
    width: 25%;
    min-width: 28;
    height: 1fr;
}
#gemdict-related { height: 1fr; }
#gemdict-related-note {
    height: auto;
    max-height: 6;
    padding: 1;
    color: #94a3b8;
}

/* Observatory: compact MacBook-friendly local ephemeris + zodiac workbench */
#observatory-root { height: 1fr; }
#obs-intro {
    height: 3;
    padding: 0 1;
    background: #090d13;
    border-bottom: solid #1f2937;
}
#observatory-chart-type {
    height: 3;
    padding: 0 1;
}
#obs-chart-mode { width: 22; margin-right: 1; }
#obs-chart-name { width: 1fr; margin-right: 1; }
#obs-birth-date { width: 20; margin-right: 1; }
#obs-birth-time { width: 16; }
#obs-natal-help, #obs-location-help, #obs-options-help {
    height: 2;
    padding: 0 1;
    color: #94a3b8;
}
#observatory-toolbar {
    height: 3;
    padding: 0 1;
    background: #090d13;
}
#observatory-options {
    height: 4;
    padding: 0 1;
    background: #090d13;
    border-bottom: solid #1f2937;
}
#obs-lat { width: 14; margin-right: 1; }
#obs-lon { width: 14; margin-right: 1; }
#obs-tz { width: 22; margin-right: 1; }
#obs-datetime { width: 20; }
#obs-zodiac { width: 16; margin-right: 1; }
#obs-sidereal { width: 18; margin-right: 1; }
#obs-houses { width: 18; margin-right: 1; }
#obs-calculate, #obs-now { min-width: 10; margin-right: 1; }
#obs-status { width: 1fr; padding: 0 0 0 1; color: #94a3b8; }
#obs-scroll {
    height: 1fr;
    margin: 0 1 1 1;
    padding: 0 1;
    background: #080c12;
    border: round #263448;
}
#obs-report { width: 1fr; }


#lock-all { width: 12; height: 3; margin: 0 1; }
